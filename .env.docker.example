# ChemMan - konfiguracja dla docker compose
# Skopiuj do .env i uzupelnij. NIE commituj pliku .env.

# ===================================================================
# WYBOR USLUG
# ===================================================================

# `bundled` = uruchom takze PostgreSQL i Redis obok aplikacji (zalecane na
# swiezym serwerze). Usun te linie, jesli masz wlasne serwery bazy i Redisa —
# wtedy MUSISZ ustawic DATABASE_URL oraz RATELIMIT_STORAGE_URL ponizej.
COMPOSE_PROFILES=bundled

# ===================================================================
# WYMAGANE
# ===================================================================

# Klucz sesji. Wygeneruj wlasny:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Haslo uzytkownika bazy danych (uslugi `db` w docker-compose.yml).
POSTGRES_PASSWORD=

# ===================================================================
# PIERWSZE URUCHOMIENIE
# ===================================================================

# Haslo konta `admin`, zakladanego przy pierwszym starcie.
# Minimum 8 znakow. USUN te zmienna po pierwszym zalogowaniu.
CHEM_MAN_ADMIN_PASSWORD=

# ===================================================================
# OPCJONALNE
# ===================================================================

# Wlasny serwer bazy danych zamiast kontenera `db`.
# Wymaga usuniecia COMPOSE_PROFILES powyzej.
# DATABASE_URL=postgresql://uzytkownik:haslo@host:5432/chemman

# Wlasny Redis zamiast kontenera `redis`.
# USTAW TO RAZEM Z DATABASE_URL. Bez dzialajacego Redisa kazde zapytanie objete
# limitem konczy sie bledem 500 — w tym /login, czyli nie zalogujesz sie wcale.
# RATELIMIT_STORAGE_URL=redis://host:6379
#
# Nie masz Redisa? Mozesz uzyc pamieci procesu:
#   RATELIMIT_STORAGE_URL=memory://
# ale kazdy worker gunicorna ma wtedy wlasne liczniki, wiec faktyczny limit jest
# ich wielokrotnoscia (przy GUNICORN_WORKERS=3 limit 10/min dziala jak 30/min).

# Liczba zaufanych odwrotnych proxy przed aplikacja.
# 1 = typowy uklad z jednym nginx-em (domyslne).
# 0 = aplikacja wystawiona bezposrednio; wtedy X-Forwarded-For jest ignorowany.
# TRUSTED_PROXY_COUNT=1

# Liczba procesow gunicorna. Rekomendacja: (2 x rdzenie) + 1.
# GUNICORN_WORKERS=3

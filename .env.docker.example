# ChemMan - konfiguracja dla docker compose
# Skopiuj do .env i uzupelnij. NIE commituj pliku .env.

# ===================================================================
# WYMAGANE
# ===================================================================

# Klucz sesji. Wygeneruj wlasny:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Haslo uzytkownika bazy danych (uslugi `db` w docker-compose.yml).
POSTGRES_PASSWORD=

# ===================================================================
# PIERWSZE URUCHOMIENIE
# ===================================================================

# Haslo konta `admin`, zakladanego przy pierwszym starcie.
# Minimum 8 znakow. USUN te zmienna po pierwszym zalogowaniu.
CHEM_MAN_ADMIN_PASSWORD=

# ===================================================================
# OPCJONALNE
# ===================================================================

# Wlasny serwer bazy danych zamiast kontenera `db`.
# Po ustawieniu startuj wylacznie aplikacje:  docker compose up -d app
# DATABASE_URL=postgresql://uzytkownik:haslo@host:5432/chemman

# Wlasny Redis zamiast kontenera `redis`.
# RATELIMIT_STORAGE_URL=redis://host:6379

# Liczba zaufanych odwrotnych proxy przed aplikacja.
# 1 = typowy uklad z jednym nginx-em (domyslne).
# 0 = aplikacja wystawiona bezposrednio; wtedy X-Forwarded-For jest ignorowany.
# TRUSTED_PROXY_COUNT=1

# Liczba procesow gunicorna. Rekomendacja: (2 x rdzenie) + 1.
# GUNICORN_WORKERS=3

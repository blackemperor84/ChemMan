# ChemMan - Przykładowa konfiguracja środowiska
# Skopiuj ten plik do .env i dostosuj wartości

# ===================================================================
# KONFIGURACJA BAZY DANYCH
# ===================================================================

# PostgreSQL (Produkcja i Development)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://chemman_user:CHANGE_THIS_PASSWORD@localhost:5432/chemman_dev

# SQLite (Tylko do szybkich testów - NIE używaj w produkcji!)
# DATABASE_URL=sqlite:///instance/chem_man.db

# ===================================================================
# KONFIGURACJA FLASK
# ===================================================================

# Środowisko: development | production | testing
FLASK_ENV=development

# Debug mode (MUSI być False w produkcji!)
FLASK_DEBUG=1

# Sekretny klucz - WYGENERUJ NOWY!
# Użyj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_please_change_this

# ===================================================================
# UŻYTKOWNIK ADMIN
# ===================================================================

# Hasło dla użytkownika admin, używane przez create_admin.py
# i update_admin_password.py. NIE MA wartości domyślnej - skrypty odmówią
# działania, jeśli tej zmiennej nie ustawisz (albo nie podasz hasła interaktywnie).
# Wygeneruj silne hasło, np.: python -c "import secrets; print(secrets.token_urlsafe(24))"
CHEM_MAN_ADMIN_PASSWORD=

# ===================================================================
# RATE LIMITING
# ===================================================================

# Redis URL dla rate limiting (opcjonalnie)
# Jeśli nie ustawione, używa pamięci (nie działa z wieloma workerami)
# RATELIMIT_STORAGE_URL=redis://localhost:6379

# Liczba zaufanych odwrotnych proxy (nginx). 0 = brak proxy (domyslnie).
# Ustaw na 1, jesli aplikacja stoi za jednym nginx-em — bez tego rate limiting
# widzi adres proxy zamiast klienta i wszyscy dziela jeden limit.
# Nie ustawiaj > 0, jesli aplikacja jest wystawiona bezposrednio: naglowek
# X-Forwarded-For mozna wtedy podrobic.
# TRUSTED_PROXY_COUNT=1

# ===================================================================
# BEZPIECZEŃSTWO (PRODUKCJA)
# ===================================================================

# Wymuszaj HTTPS cookies (MUSI być True w produkcji z SSL!)
# SESSION_COOKIE_SECURE=True

# HttpOnly cookies (zapobiega XSS)
# SESSION_COOKIE_HTTPONLY=True

# SameSite policy
# SESSION_COOKIE_SAMESITE=Lax

# ===================================================================
# UWAGI
# ===================================================================

# 1. NIE commituj pliku .env do Git!
# 2. Każde środowisko (dev/staging/prod) powinno mieć własny .env
# 3. W produkcji użyj silnych haseł i SECRET_KEY
# 4. W produkcji ustaw FLASK_DEBUG=0
# 5. W produkcji ustaw SESSION_COOKIE_SECURE=True (jeśli masz SSL)
